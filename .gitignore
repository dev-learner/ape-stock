# ape-stock/.ignore
# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Database (do not commit your live data)
*.db
*.sqlite
*.sqlite3
ape_stock.db

# Files you don't want committed
etoro-transactions.txt
handover-prompt.txt

# SQLite temporary files
*.db-shm
*.db-wal
*.db-journal

# Environment / secrets
.env
.env.*
set-env.bat

# Logs
*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Optional: large data dumps if you have any
*.csv
*.json